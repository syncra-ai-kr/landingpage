---
// English rebuilds of the four product screens (originals had burned-in Korean UI).
// Each panel: a cropped, text-free 3D render on top, the product's data view underneath.
import { Image } from 'astro:assets';
import track from '../../assets/renders/track.jpg';
import trace from '../../assets/renders/trace.jpg';
import generate from '../../assets/renders/generate.jpg';
import prove from '../../assets/renders/prove.jpg';

interface Props {
  step: 'track' | 'trace' | 'generate' | 'prove';
}
const { step } = Astro.props;
const renders = { track, trace, generate, prove };
const alts = {
  track: 'AHU-1 and pipe P-101 in the federated 3D model',
  trace: 'AHU-1 moved, leaving pipe P-101 disconnected',
  generate: 'Candidate pipe routes drawn around the duct',
  prove: 'The new pipe route connected to AHU-1',
};
---

<div class="panel">
  <Image src={renders[step]} alt={alts[step]} widths={[560, 720]} sizes="(min-width: 1024px) 560px, 100vw" class="block aspect-[2/1] w-full object-cover" />
  <div class="grid gap-4 border-t border-line p-5 text-[13.5px]">
    {
      step === 'track' && (
        <>
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="font-medium text-fg">AHU-1 air handling unit relocated</p>
              <p class="mt-1 font-mono text-[12px] text-muted">ΔX +3.4 m · design change CR-014 · nothing else edited</p>
            </div>
            <span class="chip chip-ok">Direct change</span>
          </div>
          <dl class="grid grid-cols-4 gap-2 text-center">
            {[['Changed', '2'], ['Added', '0'], ['Deleted', '0'], ['Metadata', '0']].map(([k, v]) => (
              <div class="grid gap-0.5 rounded-lg border border-line px-2 py-2.5">
                <dt class="order-2 text-[11.5px] text-muted">{k}</dt>
                <dd class="order-1 m-0 font-mono text-[18px] text-fg tabular-nums">{v}</dd>
              </div>
            ))}
          </dl>
          <ol class="flex items-center justify-between gap-2 font-mono text-[11.5px] text-muted" aria-label="Revisions">
            <li class="flex items-center gap-1.5"><i class="size-2 rounded-full bg-accent" />Rev A</li>
            <li class="h-px flex-1 bg-line" aria-hidden="true" />
            <li class="flex items-center gap-1.5 text-fg"><i class="size-2 rounded-full bg-danger" />Rev B</li>
            <li class="h-px flex-1 bg-line" aria-hidden="true" />
            <li class="flex items-center gap-1.5"><i class="size-2 rounded-full border border-faint" />Rev C</li>
            <li class="h-px flex-1 bg-line" aria-hidden="true" />
            <li class="flex items-center gap-1.5"><i class="size-2 rounded-full border border-faint" />Rev D</li>
          </ol>
        </>
      )
    }
    {
      step === 'trace' && (
        <ul class="hairline-list -my-1">
          {[
            ['chip-ok', 'Change', 'AHU-1 moved 3.4 m', 'direct'],
            ['chip-bad', 'Disconnect', 'P-101 ↔ AHU-1', 'port · 1 hop'],
            ['chip-neutral', 'System', 'Chilled water riser R-CHW', 'port · 2 hops'],
            ['chip-bad', 'Clash', 'AHU-1 ↔ T-301 cable tray', 'electrical'],
            ['chip-neutral', 'Nearby', 'D-201 · P-102 · C-1 checked', 'within 3 m'],
            ['chip-ok', 'Result', '6 candidates · 2 confirmed issues', ''],
          ].map(([c, k, v, m]) => (
            <li class="grid grid-cols-[86px_minmax(0,1fr)_auto] items-center gap-3 py-2">
              <span class:list={['chip w-fit', c]}>{k}</span>
              <span class="truncate text-fg">{v}</span>
              <span class="font-mono text-[11.5px] text-faint">{m}</span>
            </li>
          ))}
        </ul>
      )
    }
    {
      step === 'generate' && (
        <>
          <div class="flex flex-wrap items-center gap-2 font-mono text-[12px]">
            <span class="chip chip-neutral">Generated 49</span>
            <span class="chip chip-bad">Rejected 32</span>
            <span class="chip chip-ok">Passing 17</span>
          </div>
          <ul class="grid gap-1 font-mono text-[12px] text-muted">
            <li class="flex justify-between"><span><span class="text-danger">✕</span> Clashes with duct D-201</span><span class="tabular-nums">20</span></li>
            <li class="flex justify-between"><span><span class="text-danger">✕</span> Outside the allowed zone</span><span class="tabular-nums">14</span></li>
            <li class="flex justify-between"><span><span class="text-danger">✕</span> Exceeds maximum length</span><span class="tabular-nums">2</span></li>
          </ul>
          <table class="w-full font-mono text-[12px] tabular-nums">
            <thead class="text-left text-faint">
              <tr><th class="pb-1.5 font-normal">Option</th><th class="pb-1.5 font-normal">Length</th><th class="pb-1.5 font-normal">Bends</th><th class="pb-1.5 font-normal">Pressure loss</th></tr>
            </thead>
            <tbody class="text-muted">
              <tr class="border-t border-line text-fg"><td class="py-1.5"><span class="text-accent">★</span> A</td><td>10.05 m</td><td>4</td><td>3.6 kPa</td></tr>
              <tr class="border-t border-line"><td class="py-1.5">B</td><td>10.05 m</td><td>5</td><td>3.9 kPa</td></tr>
              <tr class="border-t border-line"><td class="py-1.5">C</td><td>10.35 m</td><td>5</td><td>3.9 kPa</td></tr>
            </tbody>
          </table>
        </>
      )
    }
    {
      step === 'prove' && (
        <>
          <table class="w-full font-mono text-[12px] tabular-nums">
            <thead class="text-left text-faint">
              <tr><th class="pb-1.5 font-normal">Alternative</th><th class="pb-1.5 font-normal">Move</th><th class="pb-1.5 font-normal">New issues</th></tr>
            </thead>
            <tbody class="text-muted">
              <tr class="border-t border-line text-fg"><td class="py-1.5"><span class="text-accent">★</span> Raise T-301</td><td>200 mm</td><td class="text-accent">0</td></tr>
              <tr class="border-t border-line"><td class="py-1.5">Raise T-301</td><td>300 mm</td><td>0</td></tr>
              <tr class="border-t border-line"><td class="py-1.5">Shift T-301 sideways</td><td>300 mm</td><td>0</td></tr>
              <tr class="border-t border-line"><td class="py-1.5">Move AHU-1 back</td><td>300 mm</td><td class="text-danger">1 · breaks new pipe</td></tr>
            </tbody>
          </table>
          <div class="flex items-center justify-between gap-3 rounded-lg border border-accent/30 bg-accent-soft px-3 py-2.5">
            <span class="text-fg">Re-verified: 0 clashes · connection chain complete</span>
            <span class="chip chip-ok">Resolved</span>
          </div>
        </>
      )
    }
  </div>
</div>
