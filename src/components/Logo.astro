---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg viewBox="0 0 48 48" class="size-[22px] shrink-0" aria-hidden="true">
    <rect x="6" y="6" width="22" height="22" rx="3.5" fill="none" stroke="currentColor" stroke-width="4"></rect>
    <rect x="20" y="20" width="22" height="22" rx="3.5" fill="none" stroke="currentColor" stroke-width="4"></rect>
    <rect x="22" y="22" width="6" height="6" rx="1" fill="var(--color-accent)"></rect>
  </svg>
  <span class="text-[17px] font-semibold tracking-[-0.02em]">Syncra</span>
</span>
