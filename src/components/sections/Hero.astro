---
// Interim hero (white page + current 3D story). To be replaced by the Revit/BIM screen concept in the plan.
import { Image } from 'astro:assets';
import sceneWide from '../../assets/renders/scene-wide.jpg';
import { hero } from '../../content/site';
---

<section id="top" class="hero relative isolate overflow-hidden" data-hero data-variant="minimal" aria-labelledby="hero-title">
  <div class="hero-copy container-x relative z-10 pt-32 lg:flex lg:min-h-[max(720px,100svh)] lg:flex-col lg:justify-center lg:pt-28 lg:pb-28">
    <div class="max-w-[600px]" data-hero-copy>
      <p class="hero-badge mb-8 inline-flex items-center gap-2 rounded-full px-3.5 py-1.5 text-[13px] text-fg/80">
        <span class="size-1.5 rounded-full bg-accent"></span>
        {hero.badge}
      </p>
      <h1 id="hero-title" class="h-display">{hero.title}</h1>
      <p class="lede mt-6 max-w-[48ch] text-[18px] lg:text-[19px]">{hero.body}</p>
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href={hero.primary.href} class="btn btn-primary">{hero.primary.label}</a>
        <a href={hero.secondary.href} class="btn btn-ghost">{hero.secondary.label} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>

  <!-- 3D stage: its own block under the copy on phones, the full hero background on desktop. -->
  <div class="hero-stage" data-hero-stage aria-hidden="true">
    <canvas data-hero-canvas class="hero-canvas absolute inset-0 size-full"></canvas>
    <Image
      src={sceneWide}
      alt=""
      widths={[800, 1600]}
      sizes="100vw"
      class="hero-fallback absolute inset-0 size-full object-cover object-[70%_50%]"
      loading="eager"
    />
    <div data-hero-tags class="pointer-events-none absolute inset-0"></div>
    <div class="hero-scrim pointer-events-none absolute inset-0"></div>
  </div>
</section>

<style>
  .hero-stage {
    position: relative;
    height: 460px;
    margin-top: 12px;
  }
  @media (min-width: 1024px) {
    .hero-stage {
      position: absolute;
      inset: 0;
      height: auto;
      margin: 0;
      z-index: 0;
    }
  }
  .hero-canvas {
    opacity: 0;
    transition: opacity 1.2s var(--ease-out-soft);
  }
  .hero[data-scene='ready'] .hero-canvas {
    opacity: 1;
  }
  .hero-fallback {
    display: none;
    opacity: 0.55;
  }
  .hero[data-scene='fallback'] .hero-fallback {
    display: block;
  }
  /* Fades the scene's edges into the white page; on desktop it also keeps the copy on the left legible. */
  .hero-scrim {
    background:
      linear-gradient(180deg, var(--color-bg) 0%, rgb(255 255 255 / 0) 20%),
      linear-gradient(0deg, var(--color-bg) 0%, rgb(255 255 255 / 0) 22%);
  }
  @media (min-width: 1024px) {
    /* --copy-end: where the 600px copy column ends inside the centred 1200px container */
    .hero-scrim {
      --copy-end: calc(max(32px, (100vw - 1200px) / 2 + 32px) + 600px);
      background:
        linear-gradient(
          90deg,
          rgb(255 255 255 / 0.98) 0,
          rgb(255 255 255 / 0.92) calc(var(--copy-end) - 160px),
          rgb(255 255 255 / 0.5) calc(var(--copy-end) - 20px),
          rgb(255 255 255 / 0) calc(var(--copy-end) + 140px)
        ),
        linear-gradient(0deg, var(--color-bg) 0%, rgb(255 255 255 / 0) 18%),
        linear-gradient(180deg, rgb(255 255 255 / 0.7) 0%, rgb(255 255 255 / 0) 14%);
    }
  }

  .hero-badge {
    border: 1px solid var(--color-line-strong);
    background: rgb(255 255 255 / 0.8);
  }

  /* Projected 3D labels (created by the scene script) */
  .hero :global(.scene-tag) {
    position: absolute;
    left: 0;
    top: 0;
    padding: 4px 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 1.3;
    white-space: nowrap;
    color: var(--color-fg);
    background: rgb(255 255 255 / 0.92);
    border: 1px solid var(--color-line-strong);
    border-radius: 6px;
    box-shadow: 0 4px 14px rgb(10 11 13 / 0.06);
    will-change: transform, opacity;
    transition: opacity 0.3s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hero :global(.scene-tag)::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--tag-dot, var(--color-faint));
  }
  .hero :global(.scene-tag.is-mech) {
    --tag-dot: #6f8f89;
  }
  .hero :global(.scene-tag.is-elec) {
    --tag-dot: #c28e55;
  }
  .hero :global(.scene-tag.is-plumb) {
    --tag-dot: #5b7fc7;
  }
  .hero :global(.scene-tag.is-alert) {
    --tag-dot: var(--color-danger);
    color: var(--chip-bad-fg);
    border-color: rgb(217 58 64 / 0.35);
  }
  .hero :global(.scene-tag.is-accent) {
    --tag-dot: var(--color-accent);
    color: var(--chip-ok-fg);
    border-color: rgb(14 156 136 / 0.35);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-hero]');
  if (root) {
    const start = () =>
      import('../hero/scene/mount')
        .then(({ mountHero }) => mountHero(root, 'minimal'))
        .catch(() => (root.dataset.scene = 'fallback'));
    // Defer the 3D bundle until the browser is idle so it never blocks first paint.
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
    else setTimeout(start, 200);
  }
</script>
