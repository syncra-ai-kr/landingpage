---
import SectionHeading from '../SectionHeading.astro';
import FeatureWindow from '../mockups/FeatureWindow.astro';
import { features } from '../../content/site';
---

<section id="features" class="section border-t border-line" aria-labelledby="features-title">
  <div class="container-x">
    <SectionHeading id="features-title" label={features.label} title={features.title} body={features.body} />

    <div class="mt-16 grid grid-cols-1 gap-16 lg:mt-20 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-20" data-steps>
      <ol class="grid gap-16 lg:gap-0">
        {
          features.steps.map((s, i) => (
            <li class="step grid content-center gap-4 lg:min-h-[64vh]" data-step={i}>
              <span class="font-mono text-[13px] text-faint">0{i + 1} / 04</span>
              <h3 class="text-[26px] leading-tight font-medium tracking-[-0.025em] text-fg">{s.title}</h3>
              <p class="max-w-[46ch] text-[16px] text-muted">{s.body}</p>
              <p class="mono-cmd mt-1 rounded-xl border border-line bg-surface px-4 py-3">
                <span class="k">{s.cmd[0].split(' ')[0]}</span> {s.cmd[0].split(' ').slice(1).join(' ')}
                <br />
                <span class="ok">{s.cmd[1]}</span>
              </p>
              <FeatureWindow stage={i as 0 | 1 | 2 | 3} mode="inview" class="mt-4 lg:hidden" />
            </li>
          ))
        }
      </ol>

      <!-- Desktop: one sticky window that moves through the four stages as each step reaches mid-screen. -->
      <div class="hidden lg:block">
        <div class="sticky top-[max(80px,calc(50vh-330px))]">
          <FeatureWindow stage={0} mode="scroll" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 1024px) {
    .step {
      opacity: 0.4;
      transition: opacity 0.5s var(--ease-out-soft);
    }
    .step[data-active] {
      opacity: 1;
    }
  }
</style>

<script>
  import { setStage } from '../../scripts/feature-window';

  const root = document.querySelector<HTMLElement>('[data-steps]');
  const fw = root?.querySelector<HTMLElement>('[data-fw][data-mode="scroll"]');
  if (root) {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const activate = (i: number) => {
      steps.forEach((s, k) => s.toggleAttribute('data-active', k === i));
      if (fw) setStage(fw, i);
    };
    steps[0]?.toggleAttribute('data-active', true);
    // Hold the window in its "before" state (AHU-1 not moved yet) until the first step is reached.
    if (fw && !matchMedia('(prefers-reduced-motion: reduce)').matches) setStage(fw, -1);
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) if (e.isIntersecting) activate(Number((e.target as HTMLElement).dataset.step));
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    steps.forEach((s) => io.observe(s));
  }
</script>
